<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	<package name="packagemasterv2" extends="struts-default">
			<action name="savePackageMasterV2" class="com.workshop.packagemasterv2.ClsWSPackageMasterV2Action" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >packageMaster.jsp</result>
				<result name="fail">packageMaster.jsp</result>
			</action>
	
	<action name="printPackageMasterV2" class="com.workshop.packagemasterv2.ClsWSPackageMasterV2Action" method="printAction">      
				<interceptor-ref name="params"/>
				<result name="print">${url}</result>
	</action>
			
	</package>
</struts>
