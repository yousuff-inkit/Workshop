<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	<package name="wsestimationfancy" extends="struts-default">
			<action name="saveWSEstimationFancy" class="com.workshop.wsestimationfancy.ClsWSEstimationFancyAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >estimation.jsp</result>
				<result name="fail">estimation.jsp</result>
			</action>
			
	<action name="estimationFancyView" class="com.workshop.wsestimationfancy.ClsWSEstimationFancyAction" method="saveAction">
       <interceptor-ref name="params"/>
       <result name="success" >../../../com/workshop/estimationfancy/estimation.jsp</result>
       <result name="fail">../../../com/workshop/estimationfancy/estimation.jsp</result>
	</action>
	
  <action name="estimiviw" class="com.workshop.wsestimationfancy.ClsWSEstimationFancyAction" method="saveAction">
            <interceptor-ref name="params"/>
            <result name="success" >../../../com/workshop/estimationfancy/estimation.jsp</result>
            <result name="fail">../../../com/workshop/estimationfancy/estimation.jsp</result>
     </action>
	
	</package>
</struts>
