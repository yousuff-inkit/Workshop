<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	

	<package name="evaluation" extends="struts-default">
			<action name="saveEvaluation" class="com.workshop.evaluation.ClsEvaluationAction" method="saveAction">
				<interceptor-ref name="params"/>     
				<result name="success" >evaluation.jsp</result>
				<result name="fail">evaluation.jsp</result>
			</action>
			<action name="printEvaluation" class="com.workshop.evaluation.ClsEvaluationAction" method="printAction">
				<interceptor-ref name="params"/>
				<result name="print">${url}</result>                
			</action>
		</package>	
</struts>