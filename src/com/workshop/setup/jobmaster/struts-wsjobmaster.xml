<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	
	<package name="jobmasterworkshop" extends="struts-default">
			<action name="saveJobMaster" class="com.workshop.setup.jobmaster.ClsJobMasterAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success">jobmaster.jsp</result>
				<result name="fail">jobmaster.jsp</result>
			</action>
	</package>
	
</struts>
