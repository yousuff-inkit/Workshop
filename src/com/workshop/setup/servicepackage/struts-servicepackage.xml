<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	

	<package name="servicepackage" extends="struts-default">
			<action name="saveServicePackage" class="com.workshop.setup.servicepackage.ClsServicePackageAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >servicepackage.jsp</result>
				<result name="fail">servicepackage.jsp</result>
			</action>
					</package>	
</struts>

