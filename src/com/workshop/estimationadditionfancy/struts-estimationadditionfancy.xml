<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	<package name="estimationadditionfancy" extends="struts-default">
			<action name="saveEstimationAdditionFancy" class="com.workshop.estimationadditionfancy.ClsEstimationAdditionFancyAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >estimation.jsp</result>
				<result name="fail">estimation.jsp</result>
			</action>
			<action name="estimationAdditionFancyView" class="com.workshop.estimationadditionfancy.ClsEstimationAdditionFancyAction" method="saveAction">
		       <interceptor-ref name="params"/>
		       <result name="success" >../../../com/workshop/estimationadditionfancy/estimation.jsp</result>
		       <result name="fail">../../../com/workshop/estimationadditionfancy/estimation.jsp</result>
			</action>
	</package>
</struts>
