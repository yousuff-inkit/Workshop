<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	<package name="packagemaster" extends="struts-default">
			<action name="savePackageMaster" class="com.workshop.packagemaster.ClsWSPackageMasterAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >packageMaster.jsp</result>
				<result name="fail">packageMaster.jsp</result>
			</action>
	
	<action name="printPackageMaster" class="com.workshop.packagemaster.ClsWSPackageMasterAction" method="printAction">      
				<interceptor-ref name="params"/>
				<result name="print">${url}</result>
	</action>
			
	</package>
</struts>
