<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	<package name="estimationv4" extends="struts-default">
			<action name="saveEstimationV4" class="com.workshop.estimationv4.ClsEstimationV4Action" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >estimation.jsp</result>
				<result name="fail">estimation.jsp</result>
			</action>
			
	 <action name="estimationV4View" class="com.workshop.estimationv4.ClsEstimationV4Action" method="saveAction">
       <interceptor-ref name="params"/>
       <result name="success" >../../../com/workshop/estimationv4/estimation.jsp</result>
       <result name="fail">../../../com/workshop/estimationv4/estimation.jsp</result>
	</action>
	
	<action name="printEstimationv4" class="com.workshop.estimationv4.ClsEstimationV4Action" method="printAction">      
				<interceptor-ref name="params"/>
				<result name="print">${url}</result>
	</action>
	</package>
</struts>
