<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	<package name="audatex" extends="struts-default">
			<action name="saveAudatex" class="com.dashboard.integration.audatex.ClsAudatexAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >assessment.jsp</result>
				<result name="fail">assessment.jsp</result>
			</action>
		</package>	
</struts>
