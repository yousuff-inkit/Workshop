<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	

	<package name="vehiclehistory" extends="struts-default">
			<action name="printpartwisepal" class="com.dashboard.workshop.vehiclehistorypal.ClsVehicleHistoryAction" method="printActionPartWise">
				<interceptor-ref name="params"/>
				<result name="print">VehHisParts.jrxml</result>
			</action>
			<action name="printvehiclehistrypal" class="com.dashboard.workshop.vehiclehistorypal.ClsVehicleHistoryAction" method="printActionA">
				<interceptor-ref name="params"/>
				<result name="print">${url}</result>
			</action>
			<action name="printVehicleHistoryRepairTypepal" class="com.dashboard.workshop.vehiclehistorypal.ClsVehicleHistoryAction" method="printActionRepairType">
				<interceptor-ref name="params"/>
				<result name="print">vehicleHistoryRepairType.jrxml</result>
			</action>
		</package>	
</struts>