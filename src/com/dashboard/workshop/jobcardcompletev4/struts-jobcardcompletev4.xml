<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	<package name="jobcardcompletev4" extends="struts-default">
			<action name="saveWSJobCardCompleteV4" class="com.dashboard.workshop.jobcardcompletev4.ClsJobCardCompleteV4Action" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >jobcardComplete.jsp</result>
				<result name="fail">jobcardComplete.jsp</result>
			</action>
			<action name="printWSJobCardCompleteV4" class="com.dashboard.workshop.jobcardcompletev4.ClsJobCardCompleteV4Action" method="printAction">
				<interceptor-ref name="params"/>
				<result name="print">${url}</result>
			</action>
	</package>
</struts>
