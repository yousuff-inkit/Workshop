<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	

	<package name="saveQuotation" extends="struts-default">
			<action name="saveQuotation" class="com.sales.marketing.salesquotation.ClsSalesQuotationAction" method="saveQuotationAction">
				<interceptor-ref name="params"/>
				<result name="success" >quotation.jsp</result>
				<result name="fail">quotation.jsp</result>
			</action>
			
		
		 <action name="printqoteaction" class="com.sales.marketing.salesquotation.ClsSalesQuotationAction" method="printAction">
			    <interceptor-ref name="params"/>
			    <result name="print">quotationprint.jsp</result>
			</action>
		
		</package>	
</struts>