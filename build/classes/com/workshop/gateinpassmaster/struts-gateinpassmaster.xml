<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	
	<package name="gateinpassmaster" extends="struts-default">
			<action name="GateInPassSave" class="com.workshop.gateinpassmaster.ClsGateInPassAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >gateInPass.jsp</result>
				<result name="fail">gateInPass.jsp</result>
			</action>
                       <action name="gateinpassviw" class="com.workshop.gateinpassmaster.ClsGateInPassAction" method="saveAction">
                              <interceptor-ref name="params"/>
                              <result name="success" >gateInPass.jsp </result>
                              <result name="fail">gateInPass.jsp </result>
                       </action>	
                       
                       	<action name="Gateinpassprint" class="com.workshop.gateinpassmaster.ClsGateInPassAction" method="printAction">
			    <interceptor-ref name="params"/>
			    <result name="print">${url}</result>
			</action>
                       
	</package>
	
</struts>
