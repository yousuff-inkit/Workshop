<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	
	<package name="workbay" extends="struts-default">
			<action name="saveWorkBay" class="com.workshop.setup.bay.ClsWorkBayAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >bay.jsp</result>
				<result name="fail">bay.jsp</result>
			</action>
	</package>
	
</struts>
