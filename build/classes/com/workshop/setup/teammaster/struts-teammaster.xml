<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	

	<package name="teammaster" extends="struts-default">
			<action name="saveTeamMaster" class="com.workshop.setup.teammaster.ClsTeamMasterAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >teamMaster.jsp</result>
				<result name="fail">teamMaster.jsp</result>
			</action>
					</package>	
</struts>

