<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	<package name="estimationadditionv3" extends="struts-default">
			<action name="saveEstimationAdditionV3" class="com.workshop.estimationadditionv3.ClsEstimationAdditionV3Action" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >estimation.jsp</result>
				<result name="fail">estimation.jsp</result>
			</action>
			<action name="estimationAdditionV3View" class="com.workshop.estimationadditionv3.ClsEstimationAdditionV3Action" method="saveAction">
       			<interceptor-ref name="params"/>
       			<result name="success" >../../../com/workshop/estimationadditionv3/estimation.jsp</result>
       			<result name="fail">../../../com/workshop/estimationadditionv3/estimation.jsp</result>
			</action>
	</package>
</struts>
