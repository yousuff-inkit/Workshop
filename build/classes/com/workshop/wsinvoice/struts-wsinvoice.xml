<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
   "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
   "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<constant name="struts.devMode" value="true" />
	<package name="wsinvoice" extends="struts-default">
			<action name="saveWSInvoice" class="com.workshop.wsinvoice.ClsWSInvoiceAction" method="saveAction">
				<interceptor-ref name="params"/>
				<result name="success" >invoice.jsp</result>
				<result name="fail">invoice.jsp</result>
			</action>
			<action name="WSInvoicePrintAction" class="com.workshop.wsinvoice.ClsWSInvoiceAction" method="printAction">
				<interceptor-ref name="params"/>
				<result name="print">${url}</result>
			</action>
	</package>
</struts>
