			<![CDATA[select @i:=@i+1 row,a.* from(SELECT concat(acsutility,'-',acsno) name,comments FROM rl_propkeys r left join re_access a on r.keydocno=a.acid where r.rdocno=$P{docno})a,(select @i:=0)c;]]>
		</queryString>
		<field name="row" class="java.lang.Long"/>
		<field name="name" class="java.lang.String"/>
		<field name="comments" class="java.lang.String"/>
	</subDataset>
