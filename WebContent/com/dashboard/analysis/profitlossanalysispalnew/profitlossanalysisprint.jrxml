	<queryString>
		<![CDATA[select b.tinno,if(b.doc_no=3 or $P{brhid}='a',c.company,concat(c.company,'(Br.)')) company,b.address cmpaddress,b.tel cmptel,c.fax,if($P{brhid}='a','All',b.branchname) branchname from my_brch b left join my_comp c on b.cmpid=c.doc_no where if($P{brhid}='a',b.mainbranch=1,b.doc_no=$P{brhid});]]>
	</queryString>
