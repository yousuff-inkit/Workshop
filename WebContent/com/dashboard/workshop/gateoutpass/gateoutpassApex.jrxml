	<parameter name="comptel" class="java.lang.String"/>
	<parameter name="branch" class="java.lang.String"/>
	<queryString>
		<![CDATA[select coalesce(ws.driver,'') drivername,coalesce(wsa.sal_name,'') serviceadvisor,coalesce(round(ws.excessamt,2),'') excessamt,coalesce(round(ws.outkm,2),'') outkm,coalesce(case when ws.outfuel=0.000 then 'Level 0/8' when ws.outfuel=0.125 then 'Level 1/8' when ws.outfuel=0.250 then 'Level 2/8' when ws.outfuel=0.375 then 'Level 3/8' when ws.outfuel=0.500 then 'Level 4/8' when ws.outfuel=0.625 then 'Level 5/8' when ws.outfuel=0.750 then 'Level 6/8' when ws.outfuel=0.875 then 'Level 7/8' when ws.outfuel=1.000 then 'Level 8/8' end,'') outfuel,coalesce(date_format(ws.outdate,'%d-%m-%Y'),'') outdate,coalesce(ws.outtime,'') outtime,coalesce(ws.desc1,'') remarks,coalesce(ac1.refname,'') insureto,date_format(lg.edate,'%d-%m-%Y %H:%i') predate,date_format(now() , '%d-%m-%Y %H:%i') pdate , b.tinno trno,c.color,g.name,ac.address,ac.per_mob mob,ac.per_tel phnno,concat(ws.regno,'-',ws.pltid) regno,date_format(ws.date , '%d-%m-%Y') date,ws.voc_no jobno,ws.username driver,
coalesce(br.brand_name,'') as brand,ac.refname customer,coalesce(u.user_name,'') person,ws.other chasisno,y.yom yom,md.vtype model,ws.kmin kms,CURDATE() as currdate 
from ws_gateinpass ws left join gl_vehbrand br on br.doc_no=ws.brdid
left join gl_vehmodel md on md.doc_no=ws.modid  left join my_acbook ac on ac.cldocno=ws.cldocno and dtype='crm' left join
my_user u on u.doc_no=ws.userid left join my_salesman wsa on (ws.serviceadvisor=wsa.doc_no and wsa.sal_type='WSA') left join gl_yom y on y.doc_no=ws.yom left join ws_gartype g on g.row_no=ws.repairtype left join my_color c on c.DOC_NO=ws.colorid left join my_brch b on b.doc_no=ws.brhid  left join datalog lg on lg.doc_no=ws.doc_no and lg.dtype='GIP' AND lg.ENTRY='A' left join my_acbook ac1 on ac1.cldocno=ws.insurcldocno and ac1.dtype='CRM' where  ws.doc_no=$P{docno} group by ws.doc_no;]]>
	</queryString>
