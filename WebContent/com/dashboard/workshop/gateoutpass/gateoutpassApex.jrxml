	<subDataset name="Dataset1" uuid="fca69e97-f765-4f06-9e68-097261a3c0db">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="fancy_workshop"/>
		<parameter name="docno" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[select det.complaintid complaintdocno,det.desc1 description,comp.compname complaint from  ws_gateinpassd det left join gl_complaint comp on det.complaintid=comp.doc_no where  det.rdocno=$P{docno};]]>
		</queryString>
		<field name="complaintdocno" class="java.lang.Integer"/>
		<field name="description" class="java.lang.String"/>
		<field name="complaint" class="java.lang.String"/>
	</subDataset>
	<parameter name="compname" class="java.lang.String"/>
	<parameter name="headerimg" class="java.lang.String"/>
	<parameter name="carimg" class="java.lang.String"/>
	<parameter name="docno" class="java.lang.Integer"/>
	<parameter name="puser" class="java.lang.String"/>
	<parameter name="isdoc1" class="java.lang.String"/>
