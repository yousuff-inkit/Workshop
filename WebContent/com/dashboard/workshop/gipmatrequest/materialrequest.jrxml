	<subDataset name="Dataset1" uuid="70cad573-e85a-4a0a-adac-83608fe6cfd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="carrentalnew"/>
		<parameter name="docno" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT @i:=@i+1 docno,base.reqdesc description,base.qty,base.price FROM (SELECT reqdesc,qty,price FROM ws_gipmatreqm m left join ws_gipmatreqd d on d.rdocno=m.doc_no WHERE m.STATUS=3 and m.gipdocno=$P{docno}) base,(SELECT @i:=0) r]]>
		</queryString>
		<field name="docno" class="java.lang.Long"/>
		<field name="description" class="java.lang.String"/>
		<field name="qty" class="java.math.BigDecimal"/>
		<field name="price" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="preparedby " class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{preparedby }]]></defaultValueExpression>
	</parameter>
	<parameter name="printedby" class="java.lang.String"/>
	<parameter name="receivedby" class="java.lang.String"/>
	<parameter name="processedby" class="java.lang.String"/>
	<parameter name="page" class="java.lang.String"/>
	<parameter name="imgpath" class="java.lang.String"/>
	<parameter name="docno" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT coalesce(requsr.user_name,'') requser,coalesce(priceusr.user_name,'') priceuser,coalesce(techusr.user_name,'') techuser,coalesce(finusr.user_name,'') finuser,req.doc_no req,req.date rcvd,gate.voc_no gipno,req.date,
b.address,b.tel tel,b.tel2 mobile,b.email email,b.tinno tino,requsr.user_name,b.branchname, req.doc_no reqdocno,CONCAT(gate.regno,' ',gate.pltid) regno,COALESCE(brd.brand_name) brandname,COALESCE(model.vtype,'') modelname,COALESCE(yom.yom,gate.yom) yom,gate.kmin km,COALESCE(gate.other,'') chassisno, coalesce(insur.refname ,COALESCE(ac.refname,gate.username)) clientname,req.createdate,req.updatedate,req.techdate,req.findate FROM ws_gipmatreqm req LEFT JOIN ws_gateinpass gate ON req.gipdocno=gate.doc_no LEFT JOIN gl_vehbrand brd ON gate.brdid=brd.doc_no AND brd.status<>7 LEFT JOIN gl_vehmodel model ON gate.modid=model.doc_no 
LEFT JOIN gl_yom yom ON gate.yom=yom.doc_no LEFT JOIN my_user requsr ON req.userid=requsr.doc_no
                 LEFT JOIN my_user priceusr ON req.priceupdateuserid=priceusr.doc_no LEFT JOIN my_user techusr ON req.techuserid=techusr.doc_no
                 LEFT JOIN my_user finusr ON req.finuserid=finusr.doc_no  left join my_acbook ac on gate.cldocno=ac.cldocno and ac.dtype='CRM' left join my_acbook insur on gate.insurcldocno=insur.cldocno and insur.dtype='CRM' left join my_brch b on b.doc_no=req.brhid
	             WHERE req.status=3 and req.gipdocno=$P{docno}]]>
	</queryString>
	<field name="req" class="java.lang.String"/>
	<field name="rcvd" class="java.lang.String"/>
	<field name="gipno" class="java.lang.String"/>
	<field name="date" class="java.sql.Date"/>
