	<field name="regno" class="java.lang.String"/>
	<field name="chassisno" class="java.lang.String"/>
	<field name="modelname" class="java.lang.String"/>
	<field name="duration" class="java.lang.String"/>
	<field name="enginesize" class="java.lang.String"/>
	<field name="packagename" class="java.lang.String"/>
