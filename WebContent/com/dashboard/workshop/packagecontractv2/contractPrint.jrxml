	<subDataset name="Dataset1" uuid="1aed2a53-2900-4d67-aa1c-893cbd63328b">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter "/>
		<parameter name="docno" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 srno,lab.strjobtype jobtype,lab.jobdesc,round(coalesce(lab.jobqty,0),2) jobqty,lab.remarks from ws_packagecontract cnt
left join ws_packagelabour lab on cnt.packagedocno=lab.rdocno,(select @i:=0) r where cnt.doc_no=$P{docno} order by lab.seqno]]>
		</queryString>
		<field name="srno" class="java.lang.String"/>
		<field name="jobtype" class="java.lang.String"/>
		<field name="jobdesc" class="java.lang.String"/>
		<field name="jobqty" class="java.lang.String"/>
	</subDataset>
	<subDataset name="Dataset_spare" uuid="8b382a56-2646-4c3b-a2ea-ed800af82352">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter "/>
		<parameter name="docno" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 srno,sp.spdesc,round(coalesce(qty,0),2) spqty from ws_packagecontract cnt
left join ws_packagespare sp on cnt.packagedocno=sp.rdocno,(select @i:=0) r
 where cnt.doc_no=$P{docno} order by sp.seqno ;]]>
		</queryString>
		<field name="srno" class="java.lang.Long"/>
		<field name="spdesc" class="java.lang.String"/>
		<field name="spqty" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="imgpal" class="java.lang.String"/>
	<parameter name="docno" class="java.lang.String"/>
	<parameter name="amountwords" class="java.lang.String"/>
	<parameter name="puser" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select cnt.voc_no contractvocno,cnt.remarks,ac.trnnumber,b.tinno,c.company company,b.address cmpaddress,b.tel cmptel,c.fax,b.branchname,DATE_FORMAT(cnt.date, '%d-%m-%Y') date,ac.refname client,coalesce(ac.per_mob,'') mobile,coalesce(ac.per_tel,'') telph,ac.fax1 fax,ac.address claddress,coalesce(cnt.regno,'') regno,coalesce(cnt.chassisno,'') chassisno,model.vtype modelname,
concat(date_format(cnt.fromdate,'%d.%m.%Y'),' to ',date_format(cnt.todate,'%d.%m.%Y')) duration,eng.enginesize,pkg.packagename,format(coalesce(pkg.amount,0),2) amount  from  
ws_packagecontract cnt 
left join gl_vehmodel model on cnt.modeldocno=model.doc_no 
left join ws_enginesize eng on model.engsizeid=eng.doc_no 
left join ws_packagem pkg on cnt.packagedocno=pkg.doc_no 
left join my_acbook ac on cnt.cldocno=ac.cldocno and ac.dtype='CRM' 
left join my_brch b on cnt.brhid=b.doc_no 
left join my_comp c on b.cmpid=c.doc_no 
where cnt.doc_no=$P{docno}]]>
	</queryString>
	<field name="amount" class="java.lang.String"/>
	<field name="contractvocno" class="java.lang.String"/>
	<field name="remarks" class="java.lang.String"/>
	<field name="trnnumber" class="java.lang.String"/>
	<field name="tinno" class="java.lang.String"/>
	<field name="company" class="java.lang.String"/>
	<field name="cmpaddress" class="java.lang.String"/>
	<field name="cmptel" class="java.lang.String"/>
	<field name="branchname" class="java.lang.String"/>
	<field name="date" class="java.lang.String"/>
