	<parameter name="imgpath" class="java.lang.String"/>
	<parameter name="date" class="java.lang.String"/>
	<parameter name="time" class="java.lang.String"/>
	<parameter name="estno" class="java.lang.String"/>
	<parameter name="brand" class="java.lang.String"/>
	<parameter name="year" class="java.lang.String"/>
	<parameter name="plateno" class="java.lang.String"/>
	<parameter name="model" class="java.lang.String"/>
	<parameter name="color" class="java.lang.String"/>
	<parameter name="mileage" class="java.lang.String"/>
	<parameter name="doc_no" class="java.lang.String"/>
	<queryString>
		<![CDATA[select coalesce(gip.other,'') chassisno,gip.doc_no,co.color,wsa.sal_name,gip.kmin mileage,y.yom year,coalesce(est.voc_no,0) estvocno,coalesce(job.voc_no,0) jobvocno,gip.regno,gip.pltid plateno,brd.brand_name brand,model.vtype model,gip.voc_no vocno from ws_gateinpass gip  left join my_color co on co.doc_no=gip.colorid and co.status=3 left join ws_estm est on gip.doc_no=est.gipno left join ws_jobcard job on (job.refno=est.doc_no and job.reftype='EST') left join gl_vehbrand brd on brd.doc_no=gip.brdid left join gl_vehmodel model on model.doc_no=gip.modid left join gl_yom y on y.doc_no=gip.yom  left join my_salesman wsa on (gip.serviceadvisor=wsa.doc_no and wsa.sal_type='WSA') where gip.status=3 and gip.processstatus<>8  and gip.brhid=1 and gip.doc_no=$P{doc_no}]]>
	</queryString>
	<field name="doc_no" class="java.lang.String"/>
	<field name="sal_name" class="java.lang.String"/>
	<field name="mileage" class="java.lang.String"/>
	<field name="year" class="java.lang.String"/>
