	<subDataset name="Dataset1" uuid="37fb902c-842f-4ad8-a631-bbbabf01fd4f">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="palwork"/>
		<parameter name="brhid" class="java.lang.String"/>
		<queryString>
			<![CDATA[select coalesce(insur.refname,'') inscmpy,coalesce(job.doc_no,0) jobdocno,coalesce(job.voc_no,0) jobcardno,concat(gip.regno,' ',gip.pltid,' ',brd.brand_name,' ',model.vtype) reg,gip.voc_no gipno,gip.doc_no docno,coalesce(case when ac.refname='' then gip.clientname else ac.refname end,gip.clientname) clientname,concat(date_format(gip.estdeldate,'%d.%m.%Y'),' ',gip.estdeltime) datentime from ws_gateinpass gip left join my_acbook ac on gip.cldocno=ac.cldocno and ac.dtype='CRM'
left join my_acbook insur on gip.insurcldocno=insur.cldocno and insur.dtype='CRM' left join my_brch br on gip.brhid=br.doc_no 
left join ws_gartype rt on gip.repairtype=rt.row_no left join ws_estm est on gip.doc_no=est.gipno 
left join ws_jobcard job on (job.refno=est.doc_no and job.reftype='EST') left join gl_vehbrand brd on brd.doc_no=gip.brdid left join gl_vehmodel model on model.doc_no=gip.modid left join ws_estmadd estadd on est.doc_no=estadd.doc_no  where gip.status=3 and gip.brhid=$P{brhid} and gip.processstatus in(0,1,5,6)  group by gip.doc_no order by gip.doc_no desc]]>
		</queryString>
		<field name="reg" class="java.lang.String"/>
		<field name="clientname" class="java.lang.String"/>
		<field name="inscmpy" class="java.lang.String"/>
		<field name="datentime" class="java.lang.String"/>
		<field name="jobcardno" class="java.lang.Long"/>
		<field name="gipno" class="java.lang.Long"/>
	</subDataset>
	<parameter name="imgheader" class="java.lang.String"/>
	<parameter name="imgfooter" class="java.lang.String"/>
	<parameter name="brhid" class="java.lang.String"/>
	<queryString>
		<![CDATA[select 'name' as name,branchname,(select company from my_comp)company,address,tel,fax from my_brch where doc_no=$P{brhid}]]>
	</queryString>
	<field name="branchname" class="java.lang.String"/>
