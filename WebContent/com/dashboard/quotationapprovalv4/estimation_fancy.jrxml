	<subDataset name="spareparts" uuid="aa8b55df-0014-48cc-99bd-aa7afa9da664">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="fancy_workshop"/>
		<parameter name="docno" class="java.lang.String"/>
		<parameter name="addition" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 as srno,a.* from(select * from ( select round(spare.qty,0) qty,spare.description sparedesc,
round(spare.approvedvalue,2) approvedvalue,round(spare.approvedvalue/spare.qty,2)rate  from ws_estspare spare
left join my_main m on spare.psrno=m.psrno left join my_unitm u on m.munit=u.doc_no
left join my_prodattrib at on(at.mpsrno=m.doc_no) left join  my_brand bd on m.brandid=bd.doc_no
left join my_prddin i on(i.psrno=m.psrno and i.prdid=m.doc_no and i.specno=at.mspecno) where  spare.rdocno=$P{docno} and spare.addition=$P{addition}  order by i.date,spare.srno) a)a,(select @i:=0) r;]]>
		</queryString>
		<field name="srno" class="java.lang.String"/>
		<field name="qty" class="java.math.BigDecimal"/>
		<field name="sparedesc" class="java.lang.String"/>
		<field name="approvedvalue" class="java.math.BigDecimal"/>
		<field name="rate" class="java.math.BigDecimal"/>
		<group name="qty">
			<groupExpression><![CDATA[$F{qty}]]></groupExpression>
		</group>
		<group name="sparedesc">
			<groupExpression><![CDATA[$F{sparedesc}]]></groupExpression>
		</group>
		<group name="approvedvalue">
			<groupExpression><![CDATA[$F{approvedvalue}]]></groupExpression>
		</group>
		<group name="rate">
			<groupExpression><![CDATA[$F{rate}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="service" uuid="2e038d69-b10f-4931-b643-8584d4f817c7">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="fancy_workshop"/>
		<parameter name="docno" class="java.lang.String"/>
		<parameter name="addition" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 as srno,a.* from(select m.desc1 jobdesc,lab.hrs,t.type jobtype,round(lab.total,2) total,round(lab.total/lab.hrs,2)rate from ws_estlabour lab left join ws_jobmaster m on (lab.jobid=m.doc_no ) left join ws_jobtype t on m.jobid=t.doc_no  where m.status=3 and lab.rdocno=$P{docno} and lab.addition=$P{addition} order by lab.srno)a,(select @i:=0) r;]]>
		</queryString>
		<field name="srno" class="java.lang.String"/>
		<field name="jobtype" class="java.lang.String"/>
		<field name="jobdesc" class="java.lang.String"/>
		<field name="hrs" class="java.lang.String"/>
		<field name="rate" class="java.math.BigDecimal"/>
		<field name="total" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="complaints" uuid="5cbe1bb3-f3a1-4ab2-9a60-15e6c4e5f199">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="fancy_workshop"/>
		<parameter name="gatedocno" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 as srno,a.* from(select comp.compname complaint,gate.desc1 description,comp.doc_no complaintid from ws_gateinpassd gate left join gl_complaint comp on gate.complaintid=comp.doc_no where gate.rdocno=$P{gatedocno})a,(select @i:=0) r;]]>
		</queryString>
		<field name="srno" class="java.lang.String"/>
		<field name="complaint" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="complaintid" class="java.lang.Integer"/>
	</subDataset>
	<parameter name="spareparts" class="java.lang.String"/>
	<parameter name="service" class="java.lang.String"/>
	<parameter name="vattotal" class="java.lang.String"/>
	<parameter name="estimation" class="java.lang.String"/>
	<parameter name="lblvattotal" class="java.lang.String"/>
	<parameter name="docno" class="java.lang.String"/>
	<parameter name="imgheader" class="java.lang.String"/>
	<parameter name="vocno" class="java.lang.String"/>
	<parameter name="gatedocno" class="java.lang.String"/>
	<parameter name="addition" class="java.lang.String"/>
	<parameter name="printname" class="java.lang.String"/>
	<queryString>
		<![CDATA[select round(if(d.addition=$P{addition},d.servicestotal,em.servicestotal),2)servicestotal,round(if(d.addition=$P{addition},d.servicesdiscount,em.servicesdiscount),2)servicesdiscount,round(if(d.addition=$P{addition},d.netservices,em.netservices),2)netservices,round(prv.sparemarkup,2)sparemarkup,round(if(d.addition=$P{addition},d.sparetotal,em.sparetotal),2)sparetotal,round(if(d.addition=$P{addition},d.sparediscount,em.sparediscount),2) sparediscount1,round(if(d.addition=$P{addition},d.sparenettotal,em.sparenettotal),2)sparenettotal,u.user_id,round(coalesce(gp.kmin,0),0) lblkm,brch.tinno comptrn,cmp.tel,cmp.fax,cmp.company,brch.branchname,
em.sparetot sparetot,em.gipno,em.labouttot,em.discount,em.nettotal,gp.claim,concat(gp.regno,'-',gp.pltid) regno,
gp.mainremarks,coalesce(gp.vehother,'') vehother,gp.other,ac.refname client, DATE_FORMAT(em.date, '%d-%m-%Y') date,
em.doc_no,case when d.addition>0 then concat(em.voc_no,'/',d.addition) else em.voc_no end estvocno,gp.voc_no gipvocno,vbrand.brand_name,vmodel.vtype,yom.yom,gp.doc_no gipno,gp.lpo,
round(gp.lpoamount,2) lpoamount,gp.excess,round(gp.excessamt,2) excessamt,gp.username from ws_estm em
left join ws_gateinpass gp on em.gipno=gp.doc_no left join gl_vehbrand vbrand on(gp.brdid=vbrand.doc_no)
left join gl_yom yom on gp.yom=yom.doc_no left join
my_acbook ac on gp.cldocno=ac.cldocno and dtype='CRM' left join my_brch brch on em.brhid=brch.doc_no left join my_comp cmp on brch.branch=cmp.comp_id
left join gl_vehmodel vmodel on gp.modid=vmodel.doc_no left join my_user u on em.userid=u.doc_no left join my_clprivilage prv on ac.privillege=prv.doc_no left join ws_estmadd d on d.doc_no=em.doc_no where em.voc_no=$P{vocno};]]>
	</queryString>
	<field name="lblkm" class="java.lang.String"/>
	<field name="user_id" class="java.lang.String"/>
	<field name="comptrn" class="java.lang.String"/>
