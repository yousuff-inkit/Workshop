	<subDataset name="Dataset1" uuid="0d9dc15a-ad43-44be-836d-713970bf14b2">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="palautoAdapter"/>
		<parameter name="docno" class="java.lang.String"/>
		<parameter name="total" class="java.lang.String"/>
		<parameter name="amountwords" class="java.lang.String"/>
		<parameter name="header" class="java.lang.String"/>
		<parameter name="addition" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 as slno,a.*,type mainhead from (select lab.strjobtype type,lab.strjobdesc jobdesc,if(coalesce(d.servicelumsumamt,m.servicelumsumamt)>0,'',if(lab.total=0,'',format(lab.total,2))) amount from ws_estm  m left join ws_estlabour lab on lab.rdocno=m.doc_no  left join ws_estmadd d on m.doc_no=d.estdocno and d.addition=$P{addition} where lab.rdocno=$P{docno} and lab.addition=$P{addition} and lumsumstatus=0 order by lab.seqno)a,(select @i:=0) r union all select @j:=@j+1 as slno,a.*,'SPARE PARTS' mainhead from (select 'parts',s.description jobdesc, if(coalesce(d.lumsumamount,m.lumsumamount)>0,'',if(s.approvedvalue=0,'',format(s.approvedvalue,2))) amount from ws_estm  m left join ws_estspare s on s.rdocno=m.doc_no  left join ws_estmadd d on m.doc_no=d.estdocno and d.addition=$P{addition} where  rdocno=$P{docno} and s.addition=$P{addition} order by srno)a,(select @j:=0) r;]]>
		</queryString>
		<field name="slno" class="java.lang.String"/>
		<field name="jobdesc" class="java.lang.String"/>
		<field name="mainhead" class="java.lang.String"/>
		<field name="amount" class="java.lang.String"/>
		<group name="mainhead">
			<groupExpression><![CDATA[$F{mainhead}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="imgpath" class="java.lang.String"/>
	<parameter name="vocno" class="java.lang.String"/>
	<parameter name="docno" class="java.lang.String"/>
	<parameter name="brhid" class="java.lang.String"/>
	<parameter name="total" class="java.lang.String"/>
	<parameter name="amountwords" class="java.lang.String"/>
	<parameter name="header" class="java.lang.String"/>
	<parameter name="lumsumlabour" class="java.lang.Double"/>
	<parameter name="lumsumparts" class="java.lang.Double"/>
	<parameter name="totallumsum" class="java.lang.Double"/>
	<parameter name="notes" class="java.lang.String"/>
	<parameter name="compname" class="java.lang.String"/>
	<parameter name="compaddress" class="java.lang.String"/>
	<parameter name="comptel" class="java.lang.String"/>
	<parameter name="compfax" class="java.lang.String"/>
	<parameter name="branch" class="java.lang.String"/>
	<parameter name="location" class="java.lang.String"/>
	<parameter name="addition" class="java.lang.String"/>
	<parameter name="vatamt" class="java.lang.Double"/>
	<parameter name="nettotal" class="java.lang.Double"/>
	<parameter name="puser" class="java.lang.String"/>
	<parameter name="printchk" class="java.lang.String"/>
	<parameter name="sublet" class="java.lang.Double"/>
	<queryString>
		<![CDATA[select if(coalesce(d.addition,0)=0,em.estimatedays,d.estimatedays) estimatedays , if(coalesce(d.addition,0)=0,em.gipdatetime,d.gipdatetime)  gipdate,date_format(date_add(em.date,interval 7 day),'%d.%m.%Y') estdays,TIME_FORMAT(dd.edate, '%H:%i:%s') checkin,s.sal_name serviceadvisor,if(coalesce(d.addition,0)=0,em.voc_no,concat(em.voc_no,'-',d.addition))  estvocno,DATE_FORMAT(em.date, '%d-%m-%Y') date,ac.refname client,ac.per_mob mobile,ac.per_tel tel,ac.fax1 fax,ac.address,concat(gp.regno,'-',gp.pltid) regno,round(coalesce(gp.kmin,0),0) lblkm,vbrand.brand_name,vmodel.vtype,yom.yom,coalesce(d.claimno,em.claimno)  lpo,upper(gp.other) other from ws_estm em
left join ws_gateinpass gp on em.gipno=gp.doc_no left join datalog dd on (dd.dtype='GIP' and dd.entry='A' and dd.doc_no=gp.doc_no and dd.brhid=gp.brhid)  left join gl_vehbrand vbrand on(gp.brdid=vbrand.doc_no)
left join gl_yom yom on gp.yom=yom.doc_no left join
my_acbook ac on ((gp.cldocno=ac.cldocno and 1=$P{printchk}) or (gp.insurcldocno=ac.cldocno and 2=$P{printchk}))  and ac.dtype='CRM' 
left join gl_vehmodel vmodel on gp.modid=vmodel.doc_no left join my_user u on em.userid=u.doc_no  left join ws_estmadd d on d.doc_no=em.doc_no and d.addition=$P{addition}  left join my_salesman s on ((s.doc_no=d.serviceadvisor and coalesce(d.addition,0)>0) or (s.doc_no=gp.serviceadvisor and coalesce(d.addition,0)=0)) and s.sal_type='WSA' where em.voc_no=$P{vocno} and em.brhid=$P{brhid}  group by em.voc_no,em.brhid;]]>
	</queryString>
	<field name="estimatedays" class="java.lang.String"/>
	<field name="gipdate" class="java.lang.String"/>
	<field name="estvocno" class="java.lang.String"/>
	<field name="date" class="java.lang.String"/>
