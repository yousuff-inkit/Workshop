	<queryString>
		<![CDATA[select gp.claim refno,gp.lpo orderno,invm.remarks,ac.trnnumber,job.voc_no jobno,b.tinno,c.company company,b.address cmpaddress,b.tel cmptel,c.fax,b.branchname,b.email brchemail,b.tel2 mobile1,b.fax mobile2,invm.voc_no estvocno,DATE_FORMAT(invm.date, '%d-%m-%Y') date,ac.refname client,ac.per_mob mobile,ac.per_tel telph,ac.mail1 email,ac.address claddress,concat(gp.regno,'-',gp.pltid) regno,round(coalesce(gp.kmin,0),0) lblkm,vbrand.brand_name,vmodel.vtype, yom.yom ,coalesce(invd.claimno,'')  lpo,gp.other,coalesce(invm.discount,0.0) discount,coalesce(invm.nettotal,0.0) subtotalli from  ws_invm invm left join ws_jobcard job on (invm.reftype='JC' and invm.refno=job.doc_no) left join ws_estm em on (job.reftype='EST' and job.refno=em.doc_no)
left join ws_gateinpass gp on em.gipno=gp.doc_no left join gl_vehbrand vbrand on(gp.brdid=vbrand.doc_no)
left join gl_yom yom on gp.yom=yom.doc_no left join
my_acbook ac on ac.acno=invm.acno
left join gl_vehmodel vmodel on gp.modid=vmodel.doc_no   left join my_brch b on invm.brhid=b.doc_no left join my_comp c on b.cmpid=c.doc_no left join ws_invcalctemp invd on invd.invno=invm.doc_no  where invm.doc_no=$P{docno}  group by invm.doc_no;]]>
	</queryString>
