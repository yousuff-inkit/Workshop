						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
						<paragraph lineSpacing="Single"/>
					</textElement>
					<textFieldExpression><![CDATA["Warranty on IRONMAN 4X4 parts are as per IRONMAN 4X4 Pty Ltd policy subject to installation at an Authorized IRONMAN 4X4 dealer & subject to prior approval. "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
