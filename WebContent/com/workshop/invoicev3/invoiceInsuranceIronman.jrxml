				</reportElement>
				<textField>
					<reportElement positionType="Float" x="3" y="3" width="534" height="14" uuid="a720541f-5dd7-4888-a289-8467c973fbc3">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font isBold="true" isUnderline="true"/>
					</textElement>
					<textFieldExpression><![CDATA["IRONMAN 4WD OFFROAD CENTRE: Terms and Conditions of Service: "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="31" width="526" height="14" uuid="26ae6aef-684d-40d0-a50e-ad84d38d1547">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["I authorize IRONMAN 4WD OFFROAD CENTRE to carry out the above-specified work, I agree to pay for the labour incurred and spare parts used to carry out the job on my vehicle."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="47" width="526" height="14" uuid="ad415743-b8fb-465f-9cfe-61f8f695ab58">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
						<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["Due to unforeseen circumstances beyond the control of IRONMAN 4WD OFFROAD CENTRE, estimated completion and delivery dates are       approximate. Therefore, IRONMAN 4WD OFFROAD CENTRE is not responsible for vehicle rental costs."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="63" width="526" height="14" uuid="d0827b6b-dd56-4b4f-b219-afe59a957728">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["IRONMAN 4WD OFFROAD CENTRE is authorized to operate your vehicle on roads and highways for the purpose of testing, inspecting, or       transportation between our shops as deemed necessary for repair. "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="79" width="526" height="14" uuid="8601d150-9040-40b7-b494-a1ef329cc739">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["IRONMAN 4WD OFFROAD CENTRE is not responsible for any motor/electricals defects caused by dead/weak batteries, or window tint or       upholstery, nor can IRONMAN 4WD OFFROAD CENTRE be responsible for Car Phones, CD's, Alarms, or Custom/Modified instruments and       electronics etc. "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="95" width="526" height="14" uuid="fd44072f-ce15-4b5c-b52c-f0d42bb3cbcc">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["I / We undertake to take the delivery of the vehicle within 72 hours of advice regarding the completion of work. In the event of a delay, I / We have no objection to your charging storage charges @ AED 50/- per day along with the charges of repairs, spare parts etc. "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="111" width="526" height="14" uuid="e4b8d2ef-6b1c-4c2f-9eaf-39f6ca871c70">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["If your vehicle has been disassembled by IRONMAN 4WD OFFROAD CENTRE to determine the extent of damage and the costs of repair, and   IRONMAN 4WD OFFROAD CENTRE does not complete all related repairs you will be charged a disassemble and reassemble charge at our labour rate."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="127" width="526" height="14" uuid="24d51d27-bc8d-4ac2-a6ab-445601a7a583">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["All old parts will be discarded after a week."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="143" width="526" height="14" uuid="496a1ae7-54cc-47cd-8dac-354e980d2823">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["In the event IRONMAN 4WD OFFROAD CENTRE has ordered parts for your vehicle and then you cancel the repairs, you will be responsible             for the amount of the parts or partial payment incurred by IRONMAN 4WD OFFROAD CENTRE. "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="159" width="526" height="14" uuid="1b57353a-d919-471c-889b-605bd2cc3047">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["I declare that I have left no currency, gold jewellery, key chains or any other items of value in my vehicle at the time of handover to IRONMAN 4WD OFFROAD CENTRE to repair. "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="175" width="526" height="14" uuid="932a0e9b-b624-49e3-a37f-83a6475df49b">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					</reportElement>
					<box>
						<topPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<leftPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<bottomPen lineWidth="0.0" lineColor="#8C8C8C"/>
						<rightPen lineWidth="0.0" lineColor="#8C8C8C"/>
					</box>
					<textElement textAlignment="Left">
						<font size="8" isBold="false"/>
					</textElement>
					<textFieldExpression><![CDATA["You are requested to check the vehicle operation prior to delivery, IRONMAN 4WD OFFROAD CENTRE is not responsible for any claims after             leaving the premises and also not responsible for defects not related to the nature of jobs carried out. "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement positionType="Float" x="18" y="191" width="526" height="14" uuid="be51e0c4-74ad-4eaf-9a79-776446ae23b9">
