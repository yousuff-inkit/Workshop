	<subDataset name="Dataset2" uuid="97321295-b246-4f65-8fef-9b02997d01dd">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="invoice2021"/>
		<parameter name="docno" class="java.lang.String"/>
		<queryString>
			<![CDATA[select a.* from(
select 1 seq,srno,desc1 jobdesc,null  amount,null vat,null total from ws_invm m left join ws_invd d on d.rdocno=m.doc_no where m.doc_no=$P{docno} union all
select 2 seq,d.srno,'Labour Total',format(e.labourtotal,2) labourtotal,format(e.labourtotal*0.05,2) vat,format(e.labourtotal*1.05,2) total from ws_invd d left join ws_invcalctemp t on t.invno=d.rdocno and t.description=d.desc1 left join ws_investdata e on e.jobdocno=t.jobdocno and e.addition=t.addition where rdocno=$P{docno} union all
select 3 seq,d.srno,'Spare Total',format(e.sparetotal,2) sparetotal,format(e.sparetotal*0.05,2) vat,format(e.sparetotal*1.05,2) total from ws_invd d left join ws_invcalctemp t on t.invno=d.rdocno and t.description=d.desc1 left join ws_investdata e on e.jobdocno=t.jobdocno and e.addition=t.addition where rdocno=$P{docno} union all
select 4 seq,srno,'Total' jobdesc,format(d.amount,2)  amount,format(d.amount*0.05,2) vat,format(d.amount*1.05,2) total from ws_invm m left join ws_invd d on d.rdocno=m.doc_no where m.doc_no=$P{docno})a order by srno,seq;]]>
		</queryString>
		<field name="jobdesc" class="java.lang.String"/>
		<field name="amount" class="java.lang.String"/>
		<field name="vat" class="java.lang.String"/>
		<field name="total" class="java.lang.String"/>
	</subDataset>
	<parameter name="imgpal" class="java.lang.String"/>
	<parameter name="docno" class="java.lang.String"/>
	<parameter name="puser" class="java.lang.String"/>
	<parameter name="amountinwordspal" class="java.lang.String"/>
	<parameter name="detailsql" class="java.lang.String"/>
	<parameter name="amountwords" class="java.lang.String"/>
	<parameter name="labourtotal" class="java.lang.Double"/>
	<parameter name="partstotal" class="java.lang.Double"/>
	<parameter name="totallumsum" class="java.lang.Double"/>
	<parameter name="vatamt" class="java.lang.Double"/>
	<parameter name="nettotal" class="java.lang.Double"/>
	<parameter name="type" class="java.lang.String"/>
	<parameter name="imgpathroyal" class="java.lang.String"/>
	<parameter name="imgpathfooter" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ac.trnnumber,job.voc_no jobno,b.tinno,if(b.doc_no=3,c.company,concat(c.company,'(Br.)')) company,b.address cmpaddress,b.tel cmptel,c.fax,b.branchname,invm.voc_no estvocno,DATE_FORMAT(invm.date, '%d-%m-%Y') date,ac.refname client,ac.per_mob mobile,ac.per_tel telph,ac.fax1 fax,ac.address claddress,concat(gp.regno,'-',gp.pltid) regno,round(coalesce(gp.kmin,0),0) lblkm,vbrand.brand_name,vmodel.vtype, yom.yom  ,coalesce(invd.claimno,'')  lpo,gp.other,coalesce(invm.nettotal,0.0) subtotal from  ws_invm invm left join ws_jobcard job on (invm.reftype='JC' and invm.refno=job.doc_no) left join ws_estm em on (job.reftype='EST' and job.refno=em.doc_no)
left join ws_gateinpass gp on em.gipno=gp.doc_no left join gl_vehbrand vbrand on(gp.brdid=vbrand.doc_no)
left join gl_yom yom on gp.yom=yom.doc_no left join
my_acbook ac on ac.acno=invm.acno 
left join gl_vehmodel vmodel on gp.modid=vmodel.doc_no   left join my_brch b on invm.brhid=b.doc_no left join my_comp c on b.cmpid=c.doc_no left join ws_invcalctemp invd on invd.invno=invm.doc_no  where invm.doc_no=$P{docno}  group by invm.doc_no;]]>
	</queryString>
	<field name="subtotal" class="java.lang.Double"/>
	<field name="trnnumber" class="java.lang.String"/>
	<field name="jobno" class="java.lang.String"/>
	<field name="tinno" class="java.lang.String"/>
	<field name="company" class="java.lang.String"/>
	<field name="cmpaddress" class="java.lang.String"/>
	<field name="cmptel" class="java.lang.String"/>
