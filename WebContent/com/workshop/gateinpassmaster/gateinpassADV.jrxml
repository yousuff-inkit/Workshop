			<textField>
				<reportElement x="359" y="251" width="67" height="16" uuid="86858bb5-19ff-4c3d-8d52-09e6ba2eb6d1"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["CD Player"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="331" width="550" height="16" uuid="102aab4c-3c93-4d55-8ae7-cd700d9cdcd2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8" isBold="true"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["Advanced Auto Repairing Workshop hereby agrees to repair your vehicle upon the following terms and conditions:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="329" y="166" width="40" height="16" uuid="a6c9c876-fbb9-44e8-8b10-916f04fa656f"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["Level 5/8"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="392" y="166" width="40" height="16" uuid="64d28050-48fc-4888-976a-768de3c6b3d1"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["Level 6/8"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="451" y="166" width="40" height="16" uuid="9ecf9ac9-9ea7-49cf-9de8-eb920c76f642"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["Level 7/8"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="510" y="167" width="40" height="16" uuid="336afb5d-facd-410f-8a57-9731c155dc51"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["Level 8/8"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="374" y="6" width="68" height="16" uuid="c2c2608e-e316-46c5-9285-fe891ecef68d"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["Doc No"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="347" width="553" height="10" uuid="1289289a-c6ae-4d4c-ac42-97abd8d2230b"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["1. I authorize ADVANCE to carry out the above specified work, I agree to pay for the labour incurred and spare parts used to carry out the job on my vehicle"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="357" width="553" height="10" uuid="45802954-4dfe-4b3c-a5ea-5043194fb150"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["2. Due to unforeseen circumstances beyond the control of ADVANCE, estimated completion and delivery dates are approximate. Therefore, ADVANCE is not"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="377" width="553" height="10" uuid="7f879c57-d321-4a71-b3c3-40ad9c7e9af6"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["3. ADVANCE is authorized to operate your vehicle on roads and highway for the purpose of testing, inspecting, or transportation between our shops as deemed"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="367" width="553" height="10" uuid="79ee2521-1e91-4b3f-ab8f-f04e02fb2559"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" responsible for vehicle rental costs."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="387" width="553" height="10" uuid="7161c554-4c42-448a-959a-0adcef9c8e56"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" neccessary for repair."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="397" width="553" height="10" uuid="87cd618a-42da-4bb9-b4fc-ecffb038a9a1"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["4. ADVANCE is not responsible for any motor/electricals defects caused by dead/weak batteries, or window tint or upholstery, nor can ADVANCE be responsible for"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="407" width="553" height="10" uuid="bf1449a8-1c8d-4107-a951-3ccceff9d91a"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" Car Phones, CD's, Alarms, or Custom/Modified instruments and electronics etc. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="417" width="553" height="10" uuid="c99ec763-78c5-4332-a342-666556eb8a14"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["5. If the vehicle repaired hereunder is not picked up by you within three days after ADVANCE notifies you the repair work is completed a daily storage charge of"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="427" width="553" height="10" uuid="b5007756-c426-45bc-b714-de286eed725d"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" AED 50  per day will be added to your final bill."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="437" width="553" height="10" uuid="67ecb57f-9a11-4f65-9a0d-7b42cc71c8d1"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["6. If your vehicle has been disassembled by ADVANCE to determine the extent of damage and the costs of repair, and ADVANCE does not complete all related repairs"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="447" width="553" height="10" uuid="b971e7e1-e990-4f47-9ce2-818eb6fdb7a9"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" you will be charged a disassemble and reassemle charge at our labour rate. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="457" width="553" height="10" uuid="a7ee3f5f-af6c-49a2-a61e-ffb35533159b"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["7. All old parts will be discarded unless otherwise instructed. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="467" width="553" height="10" uuid="bd807fcf-40ab-427f-8bf3-8b525cde1d7e"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["8. In the event ADVANCE has ordered parts for your vehicle and then you cancel the repairs, you will be reponsible for the amount of the parts or partial payment"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="477" width="553" height="10" uuid="5d5fc957-7a40-4acb-a16c-88e7b59f33e7"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" incurred by ADVANCE. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="487" width="553" height="10" uuid="74bea481-5e68-45c5-9291-a74cbc40036b"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["9. I declare that I have left no currency, gold jewellery, key chains or any others items of value in my vehicle at the time of hand over to ADVANCE to carry out"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="507" width="553" height="10" uuid="f9ba62ef-0a78-40bc-91e1-b770fc0ecdc9"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["10. The customer must check all instructions & also the A/C is in proper condition before they take delivery  of their vehicle. ADVANCE is not responsible for any "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="517" width="553" height="10" uuid="5ee70f9d-2d23-44c1-b30d-faf028f924ff"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["defects once the vehicle has left company permises."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="497" width="553" height="10" uuid="fefa1b14-a341-4c88-8a83-af63e1cfbfe1"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["the repair."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="402" y="601" width="140" height="14" uuid="c36b2431-b980-450d-aa14-51c6149b85f5"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["Customer Authorization"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="189" y="38" width="68" height="16" uuid="448d21ed-cc51-47d6-94fa-6b640ea003b6"/>
				<textElement verticalAlignment="Middle">
