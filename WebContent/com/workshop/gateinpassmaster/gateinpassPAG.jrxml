			<image scaleImage="FillFrame" onErrorType="Blank">
				<reportElement positionType="Float" x="398" y="548" width="144" height="53" uuid="bda99f2d-0507-4cee-8392-b44773982ab2"/>
				<box topPadding="1" leftPadding="1" bottomPadding="1" rightPadding="1">
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<imageExpression><![CDATA[$F{signature}]]></imageExpression>
			</image>
			<staticText>
				<reportElement positionType="Float" x="402" y="601" width="140" height="14" uuid="7162b0a4-1abe-4554-9794-bd5be774f2ba"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Customer Authorization]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="497" width="553" height="10" uuid="29577d42-68b4-4bde-ab2c-a7b2fea4e170">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[the repair.]]></text>
			</staticText>
			<textField>
				<reportElement x="1" y="507" width="553" height="10" uuid="24669bcf-cf38-4dea-bf06-dccd789859d2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["10. The customer must check all instructions & also the A/C is in proper condition before they take delivery  of their vehicle. PAL is not responsible for any "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="517" width="553" height="10" uuid="07c25ac7-8647-4576-b455-c617885032cc"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["defects once the vehicle has left company permises."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="347" width="553" height="10" uuid="f5f0266e-a041-472a-a1af-7fe901ba6241"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["1. I authorize PAL to carry out the above specified work, I agree to pay for the labour incurred and spare parts used to carry out the job on my vehicle"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="357" width="553" height="10" uuid="809b3bcb-f37d-4e84-9a19-69d774c3a1cd"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["2. Due to unforeseen circumstances beyond the control of PAL, estimated completion and delivery dates are approximate. Therefore, PAL is not"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="367" width="553" height="10" uuid="ac53c83e-bfdb-4874-b66e-2beb1f7028b1"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" responsible for vehicle rental costs."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="377" width="553" height="10" uuid="330de640-247e-4761-8d52-7f5aab84a58b"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["3. PAL is authorized to operate your vehicle on roads and highway for the purpose of testing, inspecting, or transportation between our shops as deemed"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="387" width="553" height="10" uuid="42441bb1-9b2d-4175-9a5f-2280b627b25e"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" neccessary for repair."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="397" width="553" height="10" uuid="bddb4b1d-d4c7-4d2d-b16c-ad54ee1e68bd"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["4. PAL is not responsible for any motor/electricals defects caused by dead/weak batteries, or window tint or upholstery, nor can PAL be responsible for"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="407" width="553" height="10" uuid="bdaad3ea-626f-40ce-ae01-b1ee10baabc4"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" Car Phones, CD's, Alarms, or Custom/Modified instruments and electronics etc. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="417" width="553" height="10" uuid="fc230838-e002-469b-9a07-94fa12934495"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["5. If the vehicle repaired hereunder is not picked up by you within three days after PAL notifies you the repair work is completed a daily storage charge of"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="427" width="553" height="10" uuid="0a4ad691-78cb-4388-9c2e-e427305a8274"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" AED 50  per day will be added to your final bill."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="437" width="553" height="10" uuid="61b19b39-1ab3-489e-aeb0-937ae38d4e9c"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["6. If your vehicle has been disassembled by PAL to determine the extent of damage and the costs of repair, and PAL does not complete all related repairs"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="447" width="553" height="10" uuid="67bf7e20-d065-452d-84dd-a20ce9d3ad7c"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA[" you will be charged a disassemble and reassemle charge at our labour rate. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="457" width="553" height="10" uuid="277a0295-e02c-4194-92be-c4244734df2c"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["7. All old parts will be discarded unless otherwise instructed. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="467" width="553" height="10" uuid="f944843f-6e63-439d-953b-424abbd7a977"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["8. In the event PAL has ordered parts for your vehicle and then you cancel the repairs, you will be reponsible for the amount of the parts or partial payment"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="477" width="553" height="10" uuid="a4cfb724-81e2-4d1a-a9f5-8bd11da86506"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
