	<queryString>
		<![CDATA[select coalesce(ws.signature,'') signature,ws.desc1,ws.vehother,s.sal_name servadv,time_format(lg.edate,'%H:%i') checkin,coalesce(ws.mainremarks) mainremarks,if(ws.backjob=1,'YES','NO') backjob,ac1.refname insureto,date_format(lg.edate,'%d-%m-%Y %H:%i')predate,date_format(now() , '%d-%m-%Y %H:%i') pdate , b.branchname,b.tinno trno,c.color,g.name,ac.address,coalesce(ac.per_mob,ws.mobile) mob,ac.per_tel phnno,ac.mail1 email,concat(ws.regno,'-',ws.pltid) regno,date_format(ws.date , '%d-%m-%Y') date,ws.voc_no jobno,ws.username driver,
coalesce(br.brand_name,'') as brand,coalesce(ac.refname,ws.clientname) customer,ac.trnnumber tinno,u.user_name person,ws.other chasisno,y.yom yom,md.vtype model,ws.kmin kms,CURDATE() as currdate,s.mobile,ws.mobile vehmobile,ws.fuel from ws_gateinpass ws  left join my_salesman s on s.doc_no=ws.serviceadvisor and s.sal_type='WSA' left join gl_vehbrand br on br.doc_no=ws.brdid
left join gl_vehmodel md on md.doc_no=ws.modid  left join my_acbook ac on ac.cldocno=ws.cldocno and dtype='crm' left join
my_user u on u.doc_no=ws.userid left join gl_yom y on y.doc_no=ws.yom left join ws_gartype g on g.row_no=ws.repairtype left join my_color c on c.DOC_NO=ws.colorid left join my_brch b on b.doc_no=ws.brhid  left join datalog lg on lg.doc_no=ws.doc_no and lg.dtype='GIP' AND lg.ENTRY='A' left join my_acbook ac1 on ac1.cldocno=ws.insurcldocno and ac1.dtype='CRM' where  ws.doc_no=$P{docno} group by ws.doc_no;]]>
	</queryString>
