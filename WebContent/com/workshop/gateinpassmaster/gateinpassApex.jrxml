	<subDataset name="Dataset1" uuid="67a0f3e0-92b0-4eed-9d2e-6a54b4ca5594">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter "/>
		<parameter name="docno" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[select '*' srno,desc1 from ws_gateinpassd where rdocno=$P{docno}]]>
		</queryString>
		<field name="desc1" class="java.lang.String"/>
		<field name="srno" class="java.lang.String"/>
	</subDataset>
	<subDataset name="Dataset_terms" uuid="82a8203b-2926-4d00-b321-8486f54d1f3f">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter "/>
		<parameter name="docno" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[select replace(if(trm.srno='',trm.terms,concat(trm.srno,': ',trm.terms)),'@branch',br.branchname) terms,replace(if(trm.srno='',trm.terms,concat(trm.srno,': ',trm.heading)),'@branch',br.branchname) heading from ws_gateinpass gate left join my_brch br on gate.brhid=br.doc_no,ws_gateterms trm where gate.doc_no=$P{docno} order by trm.doc_no;]]>
		</queryString>
		<field name="terms" class="java.lang.String"/>
		<field name="heading" class="java.lang.String"/>
		<group name="terms">
			<groupExpression><![CDATA[$F{terms}]]></groupExpression>
		</group>
	</subDataset>
