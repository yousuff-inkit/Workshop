					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[1. I authorize PAL to carry out the above specified work, I agree to pay for the labour incurred and spare parts used to carry out the job on my vehicle]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="364" width="553" height="16" uuid="39549dc7-7117-4134-a302-b6787c2c4e90">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[2. Due to unforeseen circumstances beyond the control of PAL, estimated completion and delivery dates are appropriate. Therefore, PAL is not responsible]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="397" width="553" height="16" uuid="c6dcc4c2-8356-46e5-af82-72eabd2fc611">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[3. PAL is authorized to operate your vehicle on roads and highway for the purpose of testing, inspecting, or transportation between our shops as deemed]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="381" width="553" height="16" uuid="ceb1e757-a2ee-4f98-ba0b-ecb1ddad849f">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[  for vehicle rental costs.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="413" width="553" height="16" uuid="63cd1c11-e1dd-44dc-a9bf-c56b4216191c">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[ neccessary for repair.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="429" width="553" height="16" uuid="10f68784-8948-4b45-abcd-ac7b90f50292">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[4. PAL is not responsible for any motor/electricals defects caused by dead/weak batteries, or window tint or uphoslstery, nor can PAL be responsible for Car]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="445" width="553" height="16" uuid="caf538b8-2afe-4381-af3b-74f271caa06f">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[ Phones, CD's, Alarms, or Custom/Modified instruments and electronics etc. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="461" width="553" height="16" uuid="a78fb410-f6b3-4d8b-a599-2e4e4f62d808">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[5. If the vehicle repaired hereunder is not picked up by you within three days after PAL notifies you the repair work is completed a daily storage charge of]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="477" width="553" height="16" uuid="f9445a26-8987-4ec5-be3c-aaa61fe9305c">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[  AED 50 per day will be added to your final bill.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="493" width="553" height="16" uuid="7be75be2-b1cf-45bb-881b-3dc7e65ed9eb">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[6. If your vehicle has been disassembled by PAL to determine the extent of damage and the costs of repair, and PAL does not complete all related repairs]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="509" width="553" height="16" uuid="39bf178b-60f8-4105-8a67-f627e53daea1">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[ you will be charged a disassemble and reassemle charge at our labour rate. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="525" width="553" height="16" uuid="5b1aef9d-cfc3-45f8-a6f5-b45d98ec1198">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[7. All old parts will be discarded unless otherwise instructed. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="541" width="553" height="16" uuid="a7a98845-3bd3-418d-8d32-c82077a21d99">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[8. In the event PAL has ordered parts for your vehicle and then you cancel the repairs, you will be reponsible for the amount of the parts or partial payment]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="557" width="553" height="16" uuid="50d96183-7f30-41b5-b190-ea83c7740132">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[ incurred by PAL. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="573" width="553" height="16" uuid="8a6ed611-b9f7-44d0-9215-2ba75a3bf9b5">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[9. I declare that i have left no currency, gold jewellery, key chains or any others items of value in my vehicle at the time of hand over to PAL to carry out  the repair.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="590" width="553" height="16" uuid="b972bd39-3be1-491d-8aa5-abbb88523a03">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[10. The customer must check all instructions & also the A/C is in proper condition before they take delivery  of their vehicle. PAL is not responsible for any ]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="606" width="553" height="16" uuid="049aa235-7128-4e1a-8796-cb029ff4c8c7">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="8"/>
					<paragraph leftIndent="3" rightIndent="3"/>
				</textElement>
				<text><![CDATA[defects once the vehicle has left company permises.]]></text>
			</staticText>
