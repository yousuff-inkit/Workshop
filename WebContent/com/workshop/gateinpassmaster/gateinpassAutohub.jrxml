			<frame>
				<reportElement positionType="Float" x="0" y="194" width="554" height="249" uuid="51940257-3803-4b37-91cc-ec054c1f1bc5"/>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="1" y="204" width="553" height="11" uuid="0f9206fe-f5c8-4a1c-8f85-dbf3f9df2829"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["10. The customer must check all instructions & also the A/C is in proper condition before they take delivery  of their vehicle. "]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="4" y="215" width="533" height="11" uuid="55fe6bda-cb01-4332-8805-37abc12b7a3e"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["   "+$F{branchname}+" is not responsible for any defects once the vehicle has left company permises."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="1" y="15" width="553" height="11" uuid="1360e056-4589-4b3e-9905-409abccc1820">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
						<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					</reportElement>
					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="SansSerif" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["1. I authorize "+$F{branchname}+" to carry out the above specified work, I agree to pay for the labour incurred and spare parts used to  "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="0" y="37" width="554" height="11" uuid="f88b9702-e5d9-418e-9ad9-708fdebb25b5"/>
					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["2. Due to unforeseen circumstances beyond the control of "+$F{branchname}+" , estimated completion and delivery dates are approximate."]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="1" y="48" width="553" height="11" uuid="65a6e21f-65ce-4cb8-a260-4b2087ce8afc"/>
					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["   Therefore, "+$F{branchname}+" is not responsible for vehicle rental costs."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="1" y="60" width="553" height="11" uuid="45255382-fb43-4e0e-a03f-9675602e7367"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["3. "+$F{branchname}+" is authorized to operate your vehicle on roads and highway for the purpose of testing, inspecting, or transportation"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="1" y="71" width="553" height="11" uuid="e2a8d340-73ef-42f7-9035-45c70c723c4d"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["   between our shops as deemed neccessary for repair."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="1" y="82" width="553" height="11" uuid="51b19360-358b-48b7-8c4a-670d07e45324"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["4. "+$F{branchname}+" is not responsible for any motor/electricals defects caused by dead/weak batteries, or window tint or upholstery, nor "]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="1" y="93" width="553" height="11" uuid="fe23a12a-d4f0-4b0c-9964-a07fc4e19ac5"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["   can "+ $F{branchname}+" be responsible for Car Phones, CD's, Alarms, or Custom/Modified instruments and electronics etc. "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="1" y="104" width="553" height="11" uuid="b10304ca-f391-4bf9-8496-84366e973c95"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["5. If the vehicle repaired hereunder is not picked up by you within three days after "+$F{branchname} +" notifies you the repair work is"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="1" y="115" width="553" height="11" uuid="f44a0b99-31bf-46fc-8c5d-f51403ddb4ab"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["   completed a daily storage charge of AED 50  per day will be added to your final bill."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="1" y="126" width="553" height="11" uuid="e86d1cc1-f83e-4384-b5de-c942a45caf83"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["6. If your vehicle has been disassembled by "+$F{branchname}+" to determine the extent of damage and the costs of repair, and "]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="1" y="137" width="553" height="11" uuid="8c55874c-f1c2-43c8-9db5-2c7d40c1f1bf"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["   "+$F{branchname}+" does not "+" complete all related repairs you will be charged a disassemble and reassemle charge at our labour rate. "]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="1" y="148" width="553" height="11" uuid="63bd4200-f26f-4963-9332-6e40645a52aa"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["7. All old parts will be discarded after  3 days from date of delivery of the vehicle."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="1" y="159" width="553" height="11" uuid="f604df69-9964-4255-8ab6-9b48a123e8a9"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["8. In the event "+$F{branchname}+" has ordered parts for your vehicle and then you cancel the repairs, you will be reponsible for the"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="1" y="171" width="553" height="11" uuid="5dbb822f-bc9c-46bd-a7bc-7ab95ef907aa"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["   amount of the parts or partial payment incurred by "+$F{branchname}+"."]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="1" y="182" width="553" height="11" uuid="037ab9da-039a-4cf4-95b9-79d79cbcb8ef"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["9. I declare that I have left no currency, gold jewellery, key chains or any others valuable items,performance  the garage will not be responsible for any sad losses in my "]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="1" y="3" width="553" height="12" uuid="c96403f1-e204-422c-8821-e33ee6553dcc">
						<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
						<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					</reportElement>
					<textElement verticalAlignment="Middle">
						<font fontName="SansSerif" size="8" isBold="true"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{branchname}+ " hereby agrees to repair your vehicle upon the following terms and conditions:"]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="1" y="26" width="553" height="11" uuid="d29d13f6-c363-4fc4-b5da-2641cfbfaac2">
						<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
					</reportElement>
					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["   carry out the job on my vehicle"]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="1" y="226" width="553" height="11" uuid="24ae8dc2-2c99-4374-99a6-1c9454f75b5c"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["11. There is no warranty on the parts being replaced /in during the service."]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement positionType="Float" x="1" y="238" width="553" height="11" uuid="8f25c7d4-1425-48b7-9f3e-71abf7b2f1eb"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["12. Autohub has right to do the test drive as per the requirement and the fuel will be taken as per the charge. "]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement positionType="Float" x="8" y="193" width="526" height="11" uuid="1e7bc269-ed59-4295-9cc8-5ec14ed01d1d"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Times New Roman" size="8"/>
						<paragraph leftIndent="3" rightIndent="3"/>
					</textElement>
					<textFieldExpression><![CDATA["vehicle at the time of hand over to "+$P{branch}+" to "]]></textFieldExpression>
				</textField>
			</frame>
		</band>
	</detail>
