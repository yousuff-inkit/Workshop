	<subDataset name="Dataset1" uuid="fca69e97-f765-4f06-9e68-097261a3c0db">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="fancy_workshop"/>
		<parameter name="docno" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[select det.complaintid complaintdocno,det.desc1 description,comp.compname complaint from  ws_gateinpassd det left join gl_complaint comp on det.complaintid=comp.doc_no where  det.rdocno=$P{docno};]]>
		</queryString>
		<field name="complaintdocno" class="java.lang.Integer"/>
		<field name="description" class="java.lang.String"/>
		<field name="complaint" class="java.lang.String"/>
	</subDataset>
	<parameter name="compname" class="java.lang.String"/>
	<parameter name="headerimg" class="java.lang.String"/>
	<parameter name="carimg" class="java.lang.String"/>
	<parameter name="docno" class="java.lang.Integer"/>
	<parameter name="puser" class="java.lang.String"/>
	<queryString>
		<![CDATA[select coalesce(ws.mainremarks) mainremarks,if(ws.backjob=1,'YES','NO') backjob,ac1.refname insureto,date_format(lg.edate,'%d-%m-%Y %H:%i')predate,date_format(now() , '%d-%m-%Y %H:%i') pdate , b.tinno trno,c.color,g.name,ac.address,ac.per_mob mob,ac.per_tel phnno,concat(ws.regno,'-',ws.pltid) regno,date_format(ws.date , '%d-%m-%Y') date,ws.voc_no jobno,ws.username driver,
coalesce(br.brand_name,'') as brand,ac.refname customer,u.user_name person,ws.other chasisno,y.yom yom,md.vtype model,ws.kmin kms,CURDATE() as currdate from ws_gateinpass ws left join gl_vehbrand br on br.doc_no=ws.brdid
left join gl_vehmodel md on md.doc_no=ws.modid  left join my_acbook ac on ac.cldocno=ws.cldocno and dtype='crm' left join
my_user u on u.doc_no=ws.userid left join gl_yom y on y.doc_no=ws.yom left join ws_gartype g on g.row_no=ws.repairtype left join my_color c on c.DOC_NO=ws.colorid left join my_brch b on b.doc_no=ws.brhid  left join datalog lg on lg.doc_no=ws.doc_no and lg.dtype='GIP' AND lg.ENTRY='A' left join my_acbook ac1 on ac1.cldocno=ws.insurcldocno and ac1.dtype='CRM' where  ws.doc_no=$P{docno} group by ws.doc_no;]]>
	</queryString>
