	<subDataset name="Dataset1" uuid="66bb9e87-2394-462d-b924-0c62ccabde56">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (10)"/>
		<parameter name="refno" class="java.lang.String"/>
		<parameter name="printchk" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 as slno,a.*,'SERVICE' mainhead from(select lab.strjobdesc jobdesc,lab.total amount from ws_estlabour lab  where lab.confirmed=1 and lab.approved=1 and lab.lumsumstatus=0 and lab.rdocno=$P{refno} and (if('a'=$P{printchk},1=1,addition=$P{printchk})) order by lab.srno)a,(select @i:=0) r union all select @j:=@j+1 as slno,a.*,'SPARE PARTS' mainhead from(select lab.description jobdesc,lab.total amount from ws_estspare lab  where lab.confirmed=1 and lab.approved=1  and lab.rdocno=$P{refno} and (if('a'=$P{printchk},1=1,addition=$P{printchk})) order by lab.srno)a,(select @j:=0) r;]]>
		</queryString>
		<field name="slno" class="java.lang.Long"/>
		<field name="jobdesc" class="java.lang.String"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<field name="mainhead" class="java.lang.String"/>
		<group name="mainhead">
			<groupExpression><![CDATA[$F{mainhead}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="imgheader" class="java.lang.String"/>
	<parameter name="estdocno" class="java.lang.String"/>
	<parameter name="docno" class="java.lang.String"/>
	<parameter name="brhid" class="java.lang.String"/>
	<parameter name="refno" class="java.lang.String"/>
	<parameter name="compname" class="java.lang.String"/>
	<parameter name="compaddress" class="java.lang.String"/>
	<parameter name="comptel" class="java.lang.String"/>
	<parameter name="compfax" class="java.lang.String"/>
	<parameter name="branch" class="java.lang.String"/>
	<parameter name="location" class="java.lang.String"/>
	<parameter name="puser" class="java.lang.String"/>
	<parameter name="printchk" class="java.lang.String"/>
	<queryString>
		<![CDATA[select date_format(date_add(em.date,interval 7 day),'%d.%m.%Y') estdays,TIME_FORMAT(dd.edate, '%H:%i:%s') checkin,job.jobdesc,s.sal_name serviceadvisor,job.voc_no estvocno,DATE_FORMAT(job.date, '%d-%m-%Y') date,ac.refname client,ac.per_mob mobile,ac.per_tel tel,ac.mail1 email,ac.address,coalesce(iac.refname,'') insclient,coalesce(iac.per_mob,'') insmobile,coalesce(iac.per_tel,'') instel,coalesce(iac.mail1,'') insemail,coalesce(iac.address,'') insaddress ,concat(gp.regno,'-',gp.pltid) regno,round(coalesce(gp.kmin,0),0) lblkm,vbrand.brand_name,vmodel.vtype,yom.yom,concat(coalesce(em.claimno,''),'-',group_concat(distinct coalesce(d.claimno,'')),'/',gp.lpo)  lpo,gp.other from ws_jobcard job left join ws_estm em on (job.reftype='EST' and job.refno=em.doc_no) 
left join ws_gateinpass gp on em.gipno=gp.doc_no left join datalog dd on (dd.dtype='GIP' and dd.entry='A' and dd.doc_no=gp.doc_no and dd.brhid=gp.brhid)  left join my_salesman s on (s.doc_no=gp.serviceadvisor and s.sal_type='WSA') left join gl_vehbrand vbrand on(gp.brdid=vbrand.doc_no)
left join gl_yom yom on gp.yom=yom.doc_no left join
my_acbook ac on gp.cldocno=ac.cldocno and ac.dtype='CRM' left join
my_acbook iac on gp.insurcldocno=iac.cldocno and iac.dtype='CRM'  left join my_brch brch on em.brhid=brch.doc_no left join my_comp cmp on brch.branch=cmp.comp_id
left join gl_vehmodel vmodel on gp.modid=vmodel.doc_no left join my_user u on em.userid=u.doc_no left join my_clprivilage prv on ac.privillege=prv.doc_no left join ws_estmadd d on d.doc_no=em.doc_no where job.doc_no=$P{docno} and job.brhid=$P{brhid}  group by job.doc_no,job.brhid;]]>
	</queryString>
