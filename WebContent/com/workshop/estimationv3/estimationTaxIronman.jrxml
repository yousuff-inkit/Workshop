	<subDataset name="Dataset1" uuid="0d9dc15a-ad43-44be-836d-713970bf14b2">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="palautoAdapter"/>
		<parameter name="docno" class="java.lang.String"/>
		<parameter name="total" class="java.lang.String"/>
		<parameter name="amountwords" class="java.lang.String"/>
		<parameter name="header" class="java.lang.String"/>
		<parameter name="addition" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 as slno,a.*,type mainhead from (
select if(lab.hrs=0,'',round(lab.hrs,2)) qty,if(lab.rate=0,'',format(lab.rate,2)) rate,if(lab.jobvatpercent=0,'',round(lab.jobvatpercent)) 
vatpercent,if(lab.jobnetamount=0,'',round(lab.jobnetamount,2)) netamount,if(lab.jobvatamount=0,'',round(lab.jobvatamount,2)) 
vat,if(lab.jobdiscount=0 and lab.distservicediscount=0.0,'',round(lab.jobdiscount+lab.distservicediscount,2))  discount,
lab.strjobtype type,lab.strjobdesc jobdesc, 
if(coalesce(d.servicelumsumamt,m.servicelumsumamt)>0,'',if(lab.hrs*lab.rate=0,'',round(lab.hrs*lab.rate,2))) amount from ws_estm  m left join 
ws_estlabour lab on lab.rdocno=m.doc_no  left join ws_estmadd d on m.doc_no=d.estdocno and d.addition=$P{addition} where lab.rdocno=$P{docno} and 
lab.addition=$P{addition} and lumsumstatus=0 and (lab.strjobtype!='null' and lab.strjobtype is not null and lab.strjobtype!='SUBLET') order by 
lab.seqno
)a,(select @i:=0) r union all 
select @ii:=@ii+1 as slno,a.*,type mainhead from (
select if(lab.hrs=0,'',round(lab.hrs,2)) qty,if(lab.rate=0,'',format(lab.rate,2)) rate,if(lab.jobvatpercent=0,'',round(lab.jobvatpercent)) 
vatpercent,if(lab.jobnetamount=0,'',round(lab.jobnetamount,2)) netamount,if(lab.jobvatamount=0,'',round(lab.jobvatamount,2)) 
vat,if(lab.jobdiscount=0 and lab.distservicediscount=0.0,'',round(lab.jobdiscount+lab.distservicediscount,2)) discount,lab.strjobtype type,lab.strjobdesc 
jobdesc,if(coalesce(d.servicelumsumamt,m.servicelumsumamt)>0,'',if(lab.hrs*lab.rate=0,'',round(lab.hrs*lab.rate,2))) amount from ws_estm  m 
left join ws_estlabour lab on lab.rdocno=m.doc_no  left join ws_estmadd d on m.doc_no=d.estdocno and d.addition=$P{addition} where lab.rdocno=$P{docno} and 
lab.addition=$P{addition} and lumsumstatus=0 and (lab.strjobtype!='null' and lab.strjobtype is not null and lab.strjobtype='SUBLET') order by 
lab.seqno)a,(select @ii:=0) r union all
select @j:=@j+1 as slno,a.*,'SPARE PARTS' mainhead from (
select if(s.qty=0,'',round(s.qty,2)) qty,if(s.rate=0,'',format(s.rate,2)) 
rate,if(s.spvatpercent=0,'',round(s.spvatpercent))  vatpercent,if(s.spnetamount=0,'',round(s.spnetamount,2))  
netamount,if(s.spvatamount=0,'',round(s.spvatamount,2))  vat,if(s.spdiscount=0 and s.distsparediscount=0.0,'',round(s.spdiscount+s.distsparediscount,2)) discount,'parts',s.description 
jobdesc,if(coalesce(d.lumsumamount,m.lumsumamount)>0,'',if(s.qty*s.rate=0,'',round(s.qty*s.rate,2))) amount from ws_estm  m left join ws_estspare s on s.rdocno=m.doc_no  left join ws_estmadd d 
on m.doc_no=d.estdocno and d.addition=$P{addition} where  rdocno=$P{docno} and s.addition=$P{addition} and 
(s.description!='null' and s.description is not null) order by srno)a,(select @j:=0) r]]>
		</queryString>
		<field name="slno" class="java.lang.String"/>
		<field name="jobdesc" class="java.lang.String"/>
		<field name="mainhead" class="java.lang.String"/>
		<field name="amount" class="java.lang.Double"/>
		<field name="qty" class="java.lang.String"/>
		<field name="rate" class="java.lang.String"/>
		<field name="vatpercent" class="java.lang.String"/>
		<field name="netamount" class="java.lang.Double"/>
		<field name="vat" class="java.lang.Double"/>
		<field name="discount" class="java.lang.Double"/>
		<variable name="amountsum" class="java.lang.Double" resetType="Group" resetGroup="mainhead" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
		<variable name="discsum" class="java.lang.Double" resetType="Group" resetGroup="mainhead" calculation="Sum">
			<variableExpression><![CDATA[$F{discount}]]></variableExpression>
		</variable>
		<variable name="vatsum" class="java.lang.Double" resetType="Group" resetGroup="mainhead" calculation="Sum">
			<variableExpression><![CDATA[$F{vat}]]></variableExpression>
		</variable>
		<variable name="nettotsum" class="java.lang.Double" resetType="Group" resetGroup="mainhead" calculation="Sum">
			<variableExpression><![CDATA[$F{netamount}]]></variableExpression>
		</variable>
		<group name="mainhead">
			<groupExpression><![CDATA[$F{mainhead}]]></groupExpression>
		</group>
	</subDataset>
