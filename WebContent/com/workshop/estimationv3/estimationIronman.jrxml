	<parameter name="branch" class="java.lang.String"/>
	<parameter name="location" class="java.lang.String"/>
	<parameter name="addition" class="java.lang.String"/>
	<parameter name="vatamt" class="java.lang.Double"/>
	<parameter name="nettotal" class="java.lang.Double"/>
	<parameter name="puser" class="java.lang.String"/>
	<parameter name="printchk" class="java.lang.String"/>
	<parameter name="sublet" class="java.lang.Double"/>
	<parameter name="sumofservice" class="java.lang.Double"/>
	<parameter name="sumofparts" class="java.lang.Double"/>
	<parameter name="sumofsublet" class="java.lang.Double"/>
	<parameter name="sumofconsumable" class="java.lang.Double"/>
	<parameter name="discount" class="java.lang.Double"/>
	<queryString>
		<![CDATA[select if(coalesce(d.addition,0)=0,em.estimatedays,d.estimatedays) estimatedays , if(coalesce(d.addition,0)=0,em.gipdatetime,d.gipdatetime)  gipdate,date_format(date_add(em.date,interval 7 day),'%d.%m.%Y') estdays,TIME_FORMAT(dd.edate, '%H:%i:%s') checkin,concat(s.sal_name,' - ',s.mobile)  serviceadvisor,if(coalesce(d.addition,0)=0,em.voc_no,concat(em.voc_no,'-',d.addition))  estvocno,DATE_FORMAT(em.date, '%d-%m-%Y') date,ac.refname client,ac.trnnumber,ac.per_mob mobile,ac.per_tel tel,ac.mail1 email,ac.address,concat(gp.regno,'-',gp.pltid) regno,round(coalesce(gp.kmin,0),0) lblkm,vbrand.brand_name,vmodel.vtype,yom.yom,coalesce(d.claimno,em.claimno)  lpo,upper(gp.other) other from ws_estm em
left join ws_gateinpass gp on em.gipno=gp.doc_no left join datalog dd on (dd.dtype='GIP' and dd.entry='A' and dd.doc_no=gp.doc_no and dd.brhid=gp.brhid)  left join gl_vehbrand vbrand on(gp.brdid=vbrand.doc_no)
left join gl_yom yom on gp.yom=yom.doc_no left join
my_acbook ac on ((gp.cldocno=ac.cldocno and 1=$P{printchk}) or (gp.insurcldocno=ac.cldocno and 2=$P{printchk}))  and ac.dtype='CRM' 
left join gl_vehmodel vmodel on gp.modid=vmodel.doc_no left join my_user u on em.userid=u.doc_no  left join ws_estmadd d on d.doc_no=em.doc_no and d.addition=$P{addition}  left join my_salesman s on ((s.doc_no=d.serviceadvisor and coalesce(d.addition,0)>0) or (s.doc_no=gp.serviceadvisor and coalesce(d.addition,0)=0)) and s.sal_type='WSA' where em.voc_no=$P{vocno} and em.brhid=$P{brhid}  group by em.voc_no,em.brhid;]]>
	</queryString>
	<field name="estimatedays" class="java.lang.String"/>
	<field name="gipdate" class="java.lang.String"/>
	<field name="estvocno" class="java.lang.String"/>
