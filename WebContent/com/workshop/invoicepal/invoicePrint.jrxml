	<subDataset name="Dataset2" uuid="ee934f08-4542-40da-ae35-057e1d6a72af">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (6)"/>
		<parameter name="docno" class="java.lang.String"/>
		<queryString>
			<![CDATA[select a.* from(select desc1 jobdesc,if(amount=0,null,round(coalesce(excess,0)+coalesce(nettotal,0),2))  billamount,if(amount=0,null,round(excess,2)) lessexcess,if(amount=0,null,round(amount,2))  amount,if(amount=0,null,round(m.taxamount,2)) vat,if(amount=0,null,round(m.taxtotal,2)) total from ws_invm m left join ws_invd d on d.rdocno=m.doc_no where m.doc_no=$P{docno})a]]>
		</queryString>
		<field name="jobdesc" class="java.lang.String"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<field name="vat" class="java.math.BigDecimal"/>
		<field name="total" class="java.math.BigDecimal"/>
		<field name="billamount" class="java.math.BigDecimal"/>
		<field name="lessexcess" class="java.math.BigDecimal"/>
		<variable name="famount" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
		<variable name="fvat" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{vat}]]></variableExpression>
		</variable>
		<variable name="ftotal" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{total}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="Dataset1" uuid="77281d96-d687-4a16-a427-63e01ee9a556">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (11)"/>
		<parameter name="detailsql" class="java.lang.String"/>
		<queryString>
			<![CDATA[$P!{detailsql}]]>
		</queryString>
		<field name="type" class="java.lang.String"/>
		<field name="desc1" class="java.lang.String"/>
		<field name="amount" class="java.lang.String"/>
		<group name="type">
			<groupExpression><![CDATA[$F{type}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="imgpal" class="java.lang.String"/>
	<parameter name="docno" class="java.lang.String"/>
	<parameter name="puser" class="java.lang.String"/>
	<parameter name="amountinwordspal" class="java.lang.String"/>
	<parameter name="detailsql" class="java.lang.String"/>
	<parameter name="amountwords" class="java.lang.String"/>
	<parameter name="lumsumlabour" class="java.lang.Double"/>
	<parameter name="lumsumparts" class="java.lang.Double"/>
	<parameter name="totallumsum" class="java.lang.Double"/>
	<parameter name="vatamt" class="java.lang.Double"/>
	<parameter name="nettotal" class="java.lang.Double"/>
	<parameter name="type" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ac.trnnumber,job.voc_no jobno,b.tinno,if(b.doc_no=3,c.company,concat(c.company,'(Br.)')) company,b.address cmpaddress,b.tel cmptel,c.fax,b.branchname,invm.voc_no estvocno,DATE_FORMAT(invm.date, '%d-%m-%Y') date,ac.refname client,ac.per_mob mobile,ac.per_tel telph,ac.fax1 fax,ac.address claddress,concat(gp.regno,'-',gp.pltid) regno,round(coalesce(gp.kmin,0),0) lblkm,vbrand.brand_name,vmodel.vtype, yom.yom  ,coalesce(invd.claimno,'')  lpo,gp.other from  ws_invm invm left join ws_jobcard job on (invm.reftype='JC' and invm.refno=job.doc_no) left join ws_estm em on (job.reftype='EST' and job.refno=em.doc_no)
left join ws_gateinpass gp on em.gipno=gp.doc_no left join gl_vehbrand vbrand on(gp.brdid=vbrand.doc_no)
left join gl_yom yom on gp.yom=yom.doc_no left join
my_acbook ac on ac.acno=invm.acno 
left join gl_vehmodel vmodel on gp.modid=vmodel.doc_no   left join my_brch b on invm.brhid=b.doc_no left join my_comp c on b.cmpid=c.doc_no left join ws_invcalctemp invd on invd.invno=invm.doc_no  where invm.doc_no=$P{docno}  group by invm.doc_no;]]>
	</queryString>
