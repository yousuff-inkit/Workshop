	<subDataset name="Dataset1" uuid="0d9dc15a-ad43-44be-836d-713970bf14b2">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="palautoAdapter"/>
		<parameter name="docno" class="java.lang.String"/>
		<parameter name="total" class="java.lang.String"/>
		<parameter name="amountwords" class="java.lang.String"/>
		<queryString>
			<![CDATA[select @i:=@i+1 as slno,a.*,type mainhead from (select t.type,concat(m.desc1, ' - ',lab.remarks) jobdesc,format(lab.total,2) amount from ws_estlabour lab left join ws_jobmaster m on (lab.jobid=m.doc_no ) left join ws_jobtype t on m.jobid=t.doc_no  where m.status=3  and lab.rdocno=$P{docno} order by t.doc_no,lab.srno)a,(select @i:=0) r union all select @j:=@j+1 as slno,a.*,'SPARE PARTS' mainhead from (select 'parts',description jobdesc, format(approvedvalue,2) amount from ws_estspare where   rdocno=$P{docno} order by srno)a,(select @j:=0) r;]]>
		</queryString>
		<field name="slno" class="java.lang.String"/>
		<field name="jobdesc" class="java.lang.String"/>
		<field name="mainhead" class="java.lang.String"/>
		<field name="amount" class="java.lang.String"/>
		<group name="mainhead">
			<groupExpression><![CDATA[$F{mainhead}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="imgpath" class="java.lang.String"/>
	<parameter name="vocno" class="java.lang.String"/>
	<parameter name="docno" class="java.lang.String"/>
	<parameter name="brhid" class="java.lang.String"/>
	<parameter name="total" class="java.lang.String"/>
	<parameter name="amountwords" class="java.lang.String"/>
	<queryString>
		<![CDATA[select s.sal_name serviceadvisor,case when d.addition>0 then concat(em.voc_no,'/',d.addition) else em.voc_no end estvocno,DATE_FORMAT(em.date, '%d-%m-%Y') date,ac.refname client,ac.per_mob mobile,ac.per_tel tel,ac.fax1 fax,ac.address,concat(gp.regno,'-',gp.pltid) regno,round(coalesce(gp.kmin,0),0) lblkm,vbrand.brand_name,vmodel.vtype,yom.yom,gp.lpo,gp.other from ws_estm em
left join ws_gateinpass gp on em.gipno=gp.doc_no left join my_salesman s on s.doc_no=gp.serviceadvisor left join gl_vehbrand vbrand on(gp.brdid=vbrand.doc_no)
left join gl_yom yom on gp.yom=yom.doc_no left join
my_acbook ac on ((gp.cldocno=ac.cldocno and insurancecomp=0) or (gp.insurcldocno=ac.cldocno and insurancecomp=1))  and dtype='CRM' left join my_brch brch on em.brhid=brch.doc_no left join my_comp cmp on brch.branch=cmp.comp_id
left join gl_vehmodel vmodel on gp.modid=vmodel.doc_no left join my_user u on em.userid=u.doc_no left join my_clprivilage prv on ac.privillege=prv.doc_no left join ws_estmadd d on d.doc_no=em.doc_no where em.voc_no=$P{vocno} and em.brhid=$P{brhid}  group by em.voc_no,em.brhid;]]>
	</queryString>
	<field name="estvocno" class="java.lang.String"/>
	<field name="date" class="java.lang.String"/>
	<field name="client" class="java.lang.String"/>
	<field name="lblkm" class="java.lang.String"/>
	<field name="tel" class="java.lang.String"/>
	<field name="fax" class="java.lang.String"/>
	<field name="mobile" class="java.lang.String"/>
	<field name="address" class="java.lang.String"/>
	<field name="regno" class="java.lang.String"/>
	<field name="brand_name" class="java.lang.String"/>
	<field name="vtype" class="java.lang.String"/>
	<field name="yom" class="java.lang.String"/>
	<field name="lpo" class="java.lang.String"/>
	<field name="other" class="java.lang.String"/>
	<field name="serviceadvisor" class="java.lang.String"/>
