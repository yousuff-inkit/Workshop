	<parameter name="discount" class="java.lang.Double"/>
	<queryString>
		<![CDATA[select coalesce(vehicledet,'') vehicledet,coalesce(description,'') description,coalesce(clientdet,'') clientdet,if(coalesce(d.addition,0)=0,em.voc_no,concat(em.voc_no,'-',d.addition))  estvocno,DATE_FORMAT(em.date, '%d-%m-%Y') date from ws_estimationm em
 left join my_user u on em.userid=u.doc_no  left join ws_estmadd d on d.doc_no=em.doc_no and d.addition=$P{addition} where em.voc_no=$P{vocno} and em.brhid=$P{brhid} group by em.voc_no,em.brhid;]]>
	</queryString>
